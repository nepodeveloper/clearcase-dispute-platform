{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "DatabasePath": "App_Data/clearcase.db",
    "BusyTimeoutSeconds": 5
  },
  "DisputeEligibility": {
    "PolicyVersion": "unconfigured-v1",
    "DemoPoliciesEnabled": false
  }
}
